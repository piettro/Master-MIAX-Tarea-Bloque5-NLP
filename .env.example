# Copia este fichero a `.env` y rellena tu clave. `.env` esta en .gitignore y
# NO se sube nunca (CONTRATO C6). El hook de pre-commit lo comprueba.

# --- Proveedor de LLM (P5: Factory + Adapter) ------------------------------
# openrouter | anthropic | google | openai
AGENTE10K_LLM_PROVIDER=openrouter
AGENTE10K_LLM_MODEL=google/gemini-3.8-flash

# Modelo al que se cae ante 401/402/429. Se conmuta UNA vez por proceso: una
# vez agotado el primario no se reintenta en cada llamada (ADR-006).
AGENTE10K_LLM_MODEL_FALLBACK=google/gemini-3.5-flash-lite

# La clave del proveedor activo. Solo hace falta una.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# --- Determinismo y presupuesto -------------------------------------------
AGENTE10K_TEMPERATURA=0
AGENTE10K_SEMILLA=20260923
AGENTE10K_MAX_LLAMADAS_HERRAMIENTA=8

# --- Corpus ----------------------------------------------------------------
# Raiz del corpus descomprimido. Dentro se esperan secciones.jsonl,
# chunks.jsonl, xbrl_facts.parquet e indice/.
AGENTE10K_DIR_CORPUS=data/corpus

# --- Retrieval ----------------------------------------------------------------
# Sin tocar nada, el sistema final: hibrido, filtro previo, reescritura y
# reordenacion fusionada (ADR-021). Descomentar SOLO para reproducir a mano una
# fila de la ablacion; el baseline y `agente-10k ablacion` ya ponen lo suyo.
# AGENTE10K_RECUPERADOR=hibrido
# AGENTE10K_FILTRO_METADATOS=true
# AGENTE10K_REESCRITURA_CONSULTA=true
# AGENTE10K_REORDENACION=true
# AGENTE10K_FUSION_REORDENACION=true
AGENTE10K_RRF_K=60
AGENTE10K_K_POR_DEFECTO=5

# --- Cache ------------------------------------------------------------------
# Reejecutar el golden set no debe costar dinero dos veces.
AGENTE10K_CACHE_ACTIVA=true
AGENTE10K_DIR_CACHE=.cache/agente_10k
